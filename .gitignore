# --- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.so
.venv/
venv/
env/

# --- Test artefacts (regenerated by every run) -------------------------
tests/_images/
tests/_work/
*.img
*.dd
*.bin
!assets/*.bin

# --- Editor / OS -------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- PyInstaller --------------------------------------------------------
*.manifest
warn-*.txt

# --- Local secrets (never commit) ---------------------------------------
.env
*.pem
*.key
secrets.*

