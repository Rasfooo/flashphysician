# --- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.so
.venv/
venv/
env/

# --- Test artefacts (regenerated by every run) -------------------------
tests/_images/
tests/_work/
*.img
*.dd
*.bin
!assets/*.bin

# --- Editor / OS -------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- PyInstaller --------------------------------------------------------
*.manifest
warn-*.txt

# --- Local secrets (never commit) ---------------------------------------
.env
*.pem
*.key
secrets.*

# --- Generated assets: keep SVG sources, commit rendered previews -------
# (these are committed for README rendering; remove the lines below if you
#  prefer to regenerate them in CI instead)
# assets/*.png
# assets/*.ico
# --- Build output (never commit binaries) --------------------------------
# The old releases/ directory held 25 MB of committed .exe/.zip. Committing
# build output means every clone ships a binary nobody can audit, and those
# exact files were the ones Windows flagged. Binaries belong on the Releases
# page, produced by CI from a known commit -- not in git history.
release/
out/
dist/
build/
*.zip
*.exe
*.msi
!tests/**/*.exe
